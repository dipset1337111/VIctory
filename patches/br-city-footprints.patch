+    #[cfg(windows)]
+    #[test]
+    fn cached_city_footprints_match_layout() {
+        use std::hint::black_box;
+        use std::time::Instant;
+        let base = [3u32, 0, 0, 0, 256, 0, 256, 0x9_0001, 98, 1, 0, 0x105, 0, 0];
+        let mut descriptions = Vec::new();
+        for n in 0..4098u32 {
+            let mut d = base;
+            d[4] = 256 + n;
+            descriptions.push(d);
+        }
+        for d in descriptions.iter().chain(descriptions.iter().take(4)) {
+            assert_eq!(placed_bytes_from(d, 0), placed_bytes(d));
+        }
+        let mut padded = base;
+        padded[1] = 137;
+        padded[13] = 293;
+        assert_eq!(placed_bytes_from(&padded, 0), placed_bytes(&base));
+        if held_only() {
+            assert!(placed_bytes_from(&base, 2).unwrap() < placed_bytes(&base).unwrap());
+            assert_eq!(placed_bytes_from(&padded, 2), placed_bytes_from(&base, 2));
+        }
+        let mut buffer = base;
+        buffer[0] = BUFFER;
+        assert_eq!(placed_bytes_from(&buffer, 0), None);
+        let start = Instant::now();
+        for i in 0..100_000 {
+            black_box(placed_bytes(black_box(&descriptions[i % 64])));
+        }
+        let direct = start.elapsed();
+        let start = Instant::now();
+        for i in 0..100_000 {
+            black_box(placed_bytes_from(black_box(&descriptions[i % 64]), 0));
+        }
+        println!("100000 repeated texture footprints: direct {direct:?}, cached {:?}", start.elapsed());
+    }
