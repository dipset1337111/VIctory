+pub(crate) fn placed_bytes_from(desc: &[u32; 14], first: u32) -> Option<u64> {
+    let first = if first == 0 || !held_only() { 0 } else { first };
+    // Words 1 and 13 are padding in ResourceDesc. They do not affect a footprint.
+    let mut key = *desc;
+    key[1] = 0;
+    key[13] = 0;
+    type Known = std::collections::HashMap<([u32; 14], u32), Option<u64>>;
+    thread_local! {
+        static KNOWN: std::cell::RefCell<Known> = std::cell::RefCell::default();
+    }
+    KNOWN.with(|known| {
+        let mut known = known.borrow_mut();
+        if let Some(size) = known.get(&(key, first)) {
+            return *size;
+        }
+        // Bound retained metadata during long streaming sessions.
+        if known.len() >= 4096 {
+            known.clear();
+        }
+        let size = (|| {
+            let whole = placed_bytes(desc)?;
+            if first == 0 {
+                return Some(whole);
+            }
+            // SAFETY: 56 bytes in the description's layout.
+            let d = unsafe { desc.as_ptr().cast::<ResourceDesc>().read_unaligned() };
+            let Some(t) = texture_layout(&d).filter(|t| t.planes.len() == 1) else {
+                return Some(whole);
+            };
+            let layout = &t.planes[0].layout;
+            Some(layout.bytes_from(read_from(layout, first)).min(whole))
+        })();
+        known.insert((key, first), size);
+        size
+    })
 }
 
