@@ -0,0 +1,65 @@
+/// Read adjacent ranges in one call, retaining individual range boundaries
+/// for descriptor decoding. The caller limits each batch to eight pages.
+pub(crate) fn visit(
+    ranges: &[(usize, usize)],
+    mut read: impl FnMut(usize, &mut [u8]) -> bool,
+    mut page: impl FnMut(usize, usize, &[u8]),
+) {
+    let mut remaining = ranges;
+    let mut bytes = Vec::new();
+    while let Some(&(start, mut end)) = remaining.first() {
+        let mut count = 1;
+        while let Some(&(next, next_end)) = remaining.get(count) {
+            if next != end {
+                break;
+            }
+            end = next_end;
+            count += 1;
+        }
+        let (run, rest) = remaining.split_at(count);
+        remaining = rest;
+        bytes.resize(end - start, 0);
+        if read(start, &mut bytes) {
+            for &(a, b) in run {
+                page(a, b, &bytes[a - start..b - start]);
+            }
+        } else if count > 1 {
+            // A single unmapped page can invalidate the entire combined read.
+            for &(a, b) in run {
+                let dst = &mut bytes[..b - a];
+                if read(a, dst) {
+                    page(a, b, dst);
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::visit;
+
+    #[test]
+    fn preserves_pages_and_bytes_with_gaps_and_unmapped_pages() {
+        let ranges = [(3, 8), (8, 16), (16, 21), (32, 40)];
+        for mask in 0u8..16 {
+            let mut calls = 0;
+            let mut actual = Vec::new();
+            visit(&ranges, |a, dst| {
+                calls += 1;
+                for (i, byte) in dst.iter_mut().enumerate() {
+                    let addr = a + i;
+                    let index = ranges.iter().position(|&(lo, hi)| (lo..hi).contains(&addr)).unwrap();
+                    if mask & (1 << index) != 0 { return false; }
+                    *byte = addr as u8;
+                }
+                true
+            }, |a, b, bytes| actual.push((a, b, bytes.to_vec())));
+            let expected: Vec<_> = ranges.iter().enumerate()
+                .filter(|(i, _)| mask & (1 << i) == 0)
+                .map(|(_, &(a, b))| (a, b, (a as u8..b as u8).collect::<Vec<_>>())).collect();
+            assert_eq!(actual, expected);
+            if mask == 0 { assert_eq!(calls, 2); }
+        }
+    }
+}
