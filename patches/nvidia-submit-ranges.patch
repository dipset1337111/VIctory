+/// Remove the intersection with an earlier write, keeping the remaining spans sorted.
+fn subtract_snapshot_span(parts: &mut Vec<(usize, usize)>, start: usize, end: usize) {
+    if start >= end {
+        return;
+    }
+    let first = parts.partition_point(|&(_, hi)| hi <= start);
+    let Some(&(lo, hi)) = parts.get(first) else { return };
+    if lo >= end {
+        return;
+    }
+    if lo < start && end < hi {
+        parts[first].1 = start;
+        parts.insert(first + 1, (end, hi));
+        return;
+    }
+    let past = first + parts[first..].partition_point(|&(lo, _)| lo < end);
+    let last_end = parts[past - 1].1;
+    let mut remove_from = first;
+    if lo < start {
+        parts[first].1 = start;
+        remove_from += 1;
+    }
+    let mut remove_to = past;
+    if end < last_end {
+        parts[past - 1].0 = end;
+        remove_to -= 1;
+    }
+    parts.drain(remove_from..remove_to);
+}
+
+#[test]
+fn snapshot_span_subtraction_matches_byte_coverage() {
+    for a in 0..=8 {
+        for b in a..=8 {
+            for c in 0..=8 {
+                for d in c..=8 {
+                    let mut spans = vec![(1, 7)];
+                    subtract_snapshot_span(&mut spans, a, b);
+                    subtract_snapshot_span(&mut spans, c, d);
+                    let bytes: Vec<_> = spans.iter().flat_map(|&(lo, hi)| lo..hi).collect();
+                    let expected: Vec<_> = (1..7).filter(|x| !(a..b).contains(x) && !(c..d).contains(x)).collect();
+                    assert_eq!(bytes, expected);
+                }
+            }
+        }
+    }
+}
