+// Based on the unchanged-texture policy in PastiiJay/klbf-lab#23 (spy0eye-beep).
+fn can_trim(uploaded: bool, dirty: bool, waiting: u64, unchanged: bool) -> bool {
+    uploaded && !dirty && waiting == 0 && unchanged
+}
+
+#[cfg(test)]
+mod staging_trim_tests {
+    use super::can_trim;
+
+    #[test]
+    fn only_clean_completed_uploads_can_release_storage() {
+        assert!(can_trim(true, false, 0, true));
+        assert!(!can_trim(false, false, 0, true));
+        assert!(!can_trim(true, true, 0, true));
+        assert!(!can_trim(true, false, 1, true));
+        assert!(!can_trim(true, false, 0, false));
+    }
+}
